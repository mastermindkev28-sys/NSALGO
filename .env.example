# ─────────────────────────────────────────────────────────────────────────────
# NSALGO environment configuration
# Copy to .env.local for development. Never commit real credentials.
# Every key below is read server-side only. Nothing here is exposed to the
# browser unless it is prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# mock        → every provider uses isolated, clearly-labelled simulated data.
# production  → only configured, licensed providers are used. Missing keys make
#               that provider report "unavailable"; nothing falls back to mock.
DATA_MODE=mock

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sessions — 32+ random characters. `openssl rand -base64 48`
SESSION_SECRET=

# Postgres / Supabase. When empty (development only) an in-memory store is used.
# Falls back to POSTGRES_URL (set by the Vercel Supabase integration). Migrations
# run automatically on Vercel builds via the vercel-build script.
DATABASE_URL=

# Scheduled jobs — bearer token required by /api/cron/*
CRON_SECRET=

# ── Market data (quotes, history, options, market status) ──────────────────
# Adapter: providers/polygon. Any licensed vendor can be added under providers/.
MARKET_DATA_PROVIDER=polygon
MARKET_DATA_API_KEY=
# polygon | unusualwhales. Leave empty to use Unusual Whales when its key is set.
OPTIONS_DATA_PROVIDER=
OPTIONS_API_KEY=
# Minutes of delay imposed by your exchange entitlement (0 = real-time licence).
MARKET_DATA_DELAY_MINUTES=15
# Options flow is built from Polygon options trades (+ quotes for bid/ask side).
# Comma-separated underlyings to scan; empty = built-in list of liquid names.
OPTIONS_FLOW_SYMBOLS=
# Live quote stream (/api/market/stream) refresh interval in ms.
QUOTE_STREAM_INTERVAL_MS=2000

# ── Unusual Whales ──────────────────────────────────────────────────────────
# One key covers options chains and flow alerts, congressional trades, insider
# transactions, and the economic and earnings calendars. While it's set, each of
# those slots uses Unusual Whales unless its *_PROVIDER variable names another
# vendor (OPTIONS_DATA_PROVIDER, INSIDER_PROVIDER, CONGRESS_PROVIDER,
# ECONOMIC_CALENDAR_PROVIDER).
UNUSUAL_WHALES_API_KEY=

# ── News (licensed feed only) ───────────────────────────────────────────────
NEWS_PROVIDER=polygon
NEWS_API_KEY=

# ── SEC EDGAR (Forms 3/4/5, 13F) — official public data ─────────────────────
# SEC fair access requires a descriptive User-Agent with contact details.
# sec | unusualwhales. Leave empty to use Unusual Whales when its key is set.
INSIDER_PROVIDER=
SEC_API_CONFIG={"userAgent":"NSALGO Research contact@yourdomain.com","maxRequestsPerSecond":8,"trackedInstitutionCiks":["0001067983","0001364742","0000102909"]}

# ── Congressional disclosures (licensed aggregator of House/Senate PTRs) ───
# vendor | unusualwhales. Leave empty to use Unusual Whales when its key is set.
CONGRESS_PROVIDER=
CONGRESS_API_BASE_URL=
CONGRESS_API_KEY=

# ── Economic calendar ───────────────────────────────────────────────────────
# tradingeconomics | unusualwhales. Leave empty to use Unusual Whales when its key is set.
ECONOMIC_CALENDAR_PROVIDER=
ECONOMIC_CALENDAR_API_KEY=

# ── AI analysis layer ───────────────────────────────────────────────────────
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5

# ── Billing ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Display prices. Leave empty to render "Set in admin" placeholders.
MONTHLY_PRICE=
ANNUAL_PRICE=
BILLING_CURRENCY=USD

# ── Email (verification, password reset) ────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="NSALGO <no-reply@nsalgo.com>"

# ── Analytics ───────────────────────────────────────────────────────────────
# none | plausible | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_ID=
